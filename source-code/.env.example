# =======================================================
# PsychTriage / MindQuest — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file — it is gitignored.
# =======================================================

# FastAPI Backend URL (where uvicorn is running)
VITE_BACKEND_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (from https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Gemini Live API Key (for AiBuddyScreen real-time voice AI)
# Get this from https://aistudio.google.com/apikey
# NOTE: This key needs Gemini Live API access enabled.
VITE_GEMINI_LIVE_API_KEY=your_gemini_live_api_key_here

# ElevenLabs Agent ID — optional / fallback
# Get from https://elevenlabs.io/app/conversational-ai
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Optional / reserved for future frontend/backend config
VITE_API_URL=http://localhost:3000/api
VITE_APP_ENV=development
VITE_GOOGLE_ANALYTICS_ID=
