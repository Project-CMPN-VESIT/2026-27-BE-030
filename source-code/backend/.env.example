# =======================================================
# PsychTriage Backend — FastAPI Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file — it is gitignored.
# =======================================================

# MongoDB Atlas Connection String
# Get from https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# For local MongoDB (comment out Atlas URI above and use this instead):
# MONGODB_URI=mongodb://localhost:27017

# MongoDB Database and Collection Names
DB_NAME=Mindquest
COLLECTION_USERS=users

# Google Gemini API Key (used ONLY for post-call transcript summarization)
# Free tier available at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Webhook Secret (optional)
# Get from ElevenLabs Dashboard → Agent → Security & Webhooks
# Leave blank if you are not using ElevenLabs webhook signature verification
ELEVENLABS_WEBHOOK_SECRET=

# FastAPI Port
PORT=8000

# Admin key for GET /api/users.
# That route lists registered users, so it is DISABLED (404) unless this is set,
# and then requires an `x-admin-key` header matching this value.
# Leave blank in production unless you actually need the route.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
